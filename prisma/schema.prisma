// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

enum BookingType {
  TOUR
  LOCATION
  TRANSFER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
}

enum TourType {
  TOUR
  TRANSFER
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id String @id @default(uuid())

  ruName String
  hyName String
  enName String

  isMain Boolean @default(false)

  locations Location[] @relation("TagToTransfer")
  tours     Tour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Location {
  id   String @id @default(uuid())
  slug String

  enTitle String
  ruTitle String
  hyTitle String

  enDescription String
  ruDescription String
  hyDescription String

  enLongDescription String
  ruLongDescription String
  hyLongDescription String

  mainImage String
  images    String[]

  tags Tag[] @relation("TagToTransfer")

  minimumPrice Int

  distanceFromYerevan Int?
  entranceFees        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FROM
  fromPlaceId     String
  fromAddressText String
  fromLat         Float
  fromLng         Float

  // TO
  toPlaceId     String
  toAddressText String
  toLat         Float
  toLng         Float

  routePolyline String?
  tours         TourLocation[]

  bookings Booking[]

  @@map("Transfer")
}

model Tour {
  id   String @id @default(uuid())
  slug String

  enTitle String
  ruTitle String
  hyTitle String

  enDescription String
  ruDescription String
  hyDescription String

  mainImage String
  images    String[]

  minimumPrice Int
  duration     String?

  type        TourType @default(TOUR)

  isOvernight Boolean @default(false)
  starRating  Int?
  mealOptions Json?

  routePolyline String?
  entranceFees  Json?

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations TourLocation[]

  bookings Booking[]
}

model TourLocation {
  id String @id @default(uuid())

  tourId     String
  locationId String   @map("transferId")
  order      Int

  tour     Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tourId, locationId])
  @@index([tourId])
  @@index([tourId, order])
  @@index([locationId])
  @@map("TourTransfer")
}

model Booking {
  id String @id @default(uuid())

  bookingNumber String @unique

  type BookingType

  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod @default(CASH)

  peopleCount Int

  travelDate DateTime

  customerName       String
  customerEmail      String
  customerPhone      String
  customerTelegramId String?
  notes              String?

  totalPrice Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tourId String?
  tour   Tour?   @relation(fields: [tourId], references: [id])

  locationId String?   @map("transferId")
  location   Location? @relation(fields: [locationId], references: [id])

  @@index([status, travelDate])
}
